<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AurorahCANDigitalHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color Palette -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#FCE4EC</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_primary</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#F8E8EC</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_secondary</item>

        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.AurorahCANDigitalHub" parent="Base.Theme.AurorahCANDigitalHub" />

    <!-- Starting Theme for Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenBackground">@color/bg_gradient_start_light</item>
        <item name="postSplashScreenTheme">@style/Theme.AurorahCANDigitalHub</item>
    </style>

    <!-- Custom Logo Shape Appearance -->
    <style name="ShapeAppearance.App.RoundedLogo" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Custom Outlined TextInputLayout Style -->
    <style name="Widget.Aurorah.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_theme_primary</item>
        <item name="hintTextColor">@color/md_theme_primary</item>
        <item name="errorIconTint">@color/error_red</item>
        <item name="errorTextColor">@color/error_red</item>
        <item name="errorEnabled">true</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>
</resources>
