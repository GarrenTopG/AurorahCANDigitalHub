    <string name="about_aurorah_title">Oor Aurorah CAN</string>
    <string name="about_story">Aurorah CAN (Community Action Network) is \'n gemeenskapsorganisasie wat toegewyd is aan die mobilisering van gemeenskapsondersteuning, die verskaffing van noodsaaklike verligting, voedselsekerheid, opvoedkundige hulp en gesondheidsorgbronne aan kwesbare gesinne.</string>
    <string name="about_contact">E-pos: info@aurorahcan.org | Tel: +27 (0) 11 555 0199</string>
    <string name="about_hours">Ure: Ma - Vr: 08:00 - 17:00 | Sa: 09:00 - 13:00</string>
    <string name="about_address">Adres: Hope Gemeenskapsentrum 123, Hoofweg, Johannesburg, 2000</string>

