<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base dark application theme. -->
    <style name="Base.Theme.AurorahCANDigitalHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark Color Palette -->
        <item name="colorPrimary">#FF80AB</item>
        <item name="colorOnPrimary">#28252A</item>
        <item name="colorPrimaryContainer">@color/md_theme_primary</item>
        <item name="colorOnPrimaryContainer">#FCE4EC</item>

        <item name="colorSecondary">#E57373</item>
        <item name="colorOnSecondary">#28252A</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondary</item>
        <item name="colorOnSecondaryContainer">#F8E8EC</item>

        <item name="android:colorBackground">#1A1618</item>
        <item name="colorSurface">#28252A</item>
        <item name="colorOnSurface">#FAF8F9</item>
        <item name="colorOnSurfaceVariant">#D4D4D8</item>

        <item name="colorError">@color/error_red_dark</item>
        <item name="colorOnError">#28252A</item>

        <item name="android:statusBarColor">#1A1618</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.AurorahCANDigitalHub" parent="Base.Theme.AurorahCANDigitalHub" />

    <style name="Widget.Aurorah.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#FF80AB</item>
        <item name="hintTextColor">#FF80AB</item>
        <item name="errorIconTint">@color/error_red_dark</item>
        <item name="errorTextColor">@color/error_red_dark</item>
        <item name="errorEnabled">true</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>
</resources>
