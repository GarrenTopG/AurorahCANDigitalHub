    <string name="about_hours">Izinzuzo: Mso - Somb: 08:00 - 17:00 | Mgqib: 09:00 - 13:00</string>
    <string name="about_address">Ikheli: 123 Hope Community Center, Main Road, Johannesburg, 2000</string>

